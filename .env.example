# Comunity Environment Variables
# Copy this file to .env and fill in your values

# Backend
ENVIRONMENT=development
PORT=5000

# Supabase (local values are printed by `supabase status`)
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=your-local-supabase-anon-key
SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1

# Redis
REDIS_URL=redis://localhost:6379

# Frontend
REACT_APP_API_URL=http://localhost:5000
REACT_APP_MAPBOX_TOKEN=tu_token_mapbox

# Stripe (Phase 4)
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_PUBLIC_KEY=pk_test_xxxxx

# Email is configured in Supabase Auth. Hosted projects use Resend custom SMTP;
# do not put SMTP credentials in the FastAPI environment.

# Maps
MAPBOX_TOKEN=tu_token_mapbox

# AWS S3 (para imágenes)
AWS_ACCESS_KEY_ID=tu_key
AWS_SECRET_ACCESS_KEY=tu_secret
AWS_BUCKET=comunity-uploads
AWS_REGION=us-east-1

# Firebase (para push notifications)
FIREBASE_API_KEY=tu_firebase_key
FIREBASE_PROJECT_ID=tu_project_id

# Google OAuth
GOOGLE_CLIENT_ID=tu_client_id
GOOGLE_CLIENT_SECRET=tu_client_secret

# Facebook OAuth
FACEBOOK_APP_ID=tu_app_id
FACEBOOK_APP_SECRET=tu_app_secret

# Sentry (error tracking)
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# Analytics
MIXPANEL_TOKEN=tu_token
GA_TRACKING_ID=tu_ga_id

# Development
DEBUG=true
LOG_LEVEL=debug
