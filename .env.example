# Comunity Environment Variables
# Copy this file to .env and fill in your values

# Backend
ENVIRONMENT=development
PORT=5000

# Database
DATABASE_URL=postgresql+psycopg://comunity:desarrollo123@localhost:5432/comunity_dev
POSTGRES_USER=comunity
POSTGRES_PASSWORD=desarrollo123
POSTGRES_DB=comunity_dev

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=tu_secreto_super_secreto_aqui
JWT_EXPIRE=7d

# Frontend
REACT_APP_API_URL=http://localhost:5000
REACT_APP_MAPBOX_TOKEN=tu_token_mapbox

# Stripe (Phase 4)
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_PUBLIC_KEY=pk_test_xxxxx

# Email (SendGrid, Mailgun, etc)
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=tu_api_key

# Maps
MAPBOX_TOKEN=tu_token_mapbox

# AWS S3 (para imágenes)
AWS_ACCESS_KEY_ID=tu_key
AWS_SECRET_ACCESS_KEY=tu_secret
AWS_BUCKET=comunity-uploads
AWS_REGION=us-east-1

# Firebase (para push notifications)
FIREBASE_API_KEY=tu_firebase_key
FIREBASE_PROJECT_ID=tu_project_id

# Google OAuth
GOOGLE_CLIENT_ID=tu_client_id
GOOGLE_CLIENT_SECRET=tu_client_secret

# Facebook OAuth
FACEBOOK_APP_ID=tu_app_id
FACEBOOK_APP_SECRET=tu_app_secret

# Sentry (error tracking)
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# Analytics
MIXPANEL_TOKEN=tu_token
GA_TRACKING_ID=tu_ga_id

# Development
DEBUG=true
LOG_LEVEL=debug
